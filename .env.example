# Servidor
PORT=3000
NODE_ENV=development

# Rate limiting das rotas de escrita da API (por IP, por hora)
RATE_LIMIT_PER_HOUR=50

# CORS em produção: origens extras separadas por vírgula
# Previews *.vercel.app já são permitidos automaticamente
ALLOWED_ORIGINS=https://curriculum-facil.vercel.app

# Diagnóstico (/api/debug-env) em produção exige este token no header x-debug-token
# Deixe vazio para desabilitar a rota em produção
DEBUG_TOKEN=

# Observação: o projeto NÃO usa chave de IA no momento.
# As melhorias de texto são feitas por regras locais em server.js.
# ADSENSE_CLIENT_ID e GA_MEASUREMENT_ID são configurados diretamente no frontend.
